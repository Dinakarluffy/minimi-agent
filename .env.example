# ==========================================
# Minimi Chat Agent Environment Variables
# ==========================================

# Required: Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (default is gemini-flash-lite-latest)
# Supported models: gemini-flash-lite-latest, gemini-3.8-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-flash-lite-latest

# If omitted or exhausted, the agent automatically falls back to DuckDuckGo search with 0 setup!

# Optional: Server Port (default 3000)
PORT=3000

# Optional: SQLite Database Path (default data/agent.db)
DB_PATH=data/agent.db
