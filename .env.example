# ==========================================
# Minimi Chat Agent Environment Variables
# ==========================================

# Required: Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (default is gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# Optional: Tavily Search API Key for structured web research
# Get a free key (1000 searches/mo) at: https://tavily.com
# If omitted or exhausted, the agent automatically falls back to DuckDuckGo search with 0 setup!
TAVILY_API_KEY=

# Optional: Server Port (default 3000)
PORT=3000

# Optional: SQLite Database Path (default data/agent.db)
DB_PATH=data/agent.db
